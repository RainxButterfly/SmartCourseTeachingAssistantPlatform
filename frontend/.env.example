# 接口基础地址（默认走 Vite 代理到 Java Gateway）
VITE_API_BASE_URL=/api/v1

# 是否启用 MSW 接口 mock（true 时前端完全离线可用）
VITE_ENABLE_MOCK=true

# 单文件上传上限（MB），需与后端 2001 错误码阈值保持一致
VITE_MAX_UPLOAD_MB=50

# SSE 静默超时（毫秒）：超过该时长未收到任何帧判定连接失效
VITE_SSE_IDLE_TIMEOUT_MS=30000

# mock 模式下的开发便利开关：true=冷加载即自动登录（默认）；false=不注入，用于验证登录页与路由守卫
VITE_MOCK_AUTO_LOGIN=true